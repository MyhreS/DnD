rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isWorkshopMember() {
      return isVerified()
        && request.auth.token.email in ["simonmyhre1@gmail.com", "myhrefjeld@gmail.com", "thmyhre9@gmail.com", "03tobiasmyhre@gmail.com"];
    }

    match /workshop/{uid}/{draftId}/{fileId} {
      allow read: if isWorkshopMember();
      allow create: if isWorkshopMember()
        && request.auth.uid == uid
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
