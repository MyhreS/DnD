{
  "name": "catacombs-functions",
  "description": "Cloud Functions backend for Catacombs & Starspawns (email + party logic).",
  "private": true,
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "nodemailer": "^9.0.4"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.7.3"
  }
}
