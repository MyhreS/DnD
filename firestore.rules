rules_version = '2';

// Catacombs & Starspawns — Firestore security rules.
//
// Open access: anyone signed in with a verified Google account may use the app.
// Permissions are per-campaign: you see a campaign's data only if you're a
// member, and you control a campaign only if you're its DM (its creator).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Any verified signed-in user.
    function isUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function emailKey() {
      return request.auth.token.email;
    }

    // Super-admin (manages the legacy allowlist; not required for normal use).
    function isSuperAdmin() {
      return isUser() && emailKey() in ["simonmyhre1@gmail.com"];
    }

    // You belong to campaign `cid`.
    function isMember(cid) {
      return isUser()
        && exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.auth.uid));
    }

    // You are the DM (creator) of campaign `cid`.
    function isCampaignDM(cid) {
      return isUser()
        && get(/databases/$(database)/documents/campaigns/$(cid)).data.dmUid == request.auth.uid;
    }

    // Parent campaign of a game / session (for subcollection scoping).
    function gameCampaignId(gid) {
      return get(/databases/$(database)/documents/games/$(gid)).data.campaignId;
    }
    function gameData(gid) {
      return get(/databases/$(database)/documents/games/$(gid)).data;
    }
    function gameDataAfter(gid) {
      return getAfter(/databases/$(database)/documents/games/$(gid)).data;
    }
    function canReadGameData(data) {
      return isUser() && (
        data.dmUid == request.auth.uid
        || request.auth.uid in data.get('participantUids', [])
        || (data.campaignId != null && isMember(data.campaignId))
      );
    }
    function canReadGame(gid) {
      return canReadGameData(gameData(gid));
    }
    function isGameDM(gid) {
      return isUser() && gameDataAfter(gid).dmUid == request.auth.uid;
    }
    function sessionCampaignId(sid) {
      return get(/databases/$(database)/documents/sessions/$(sid)).data.campaignId;
    }

    // /allowlist — legacy/optional. Self + super-admin read; super-admin writes.
    match /allowlist/{email} {
      allow read: if isSuperAdmin() || (isSignedIn() && email == emailKey());
      allow write: if isSuperAdmin();
    }

    // /users/{uid} — a signed-in user's self-set profile (name). Owner only.
    match /users/{uid} {
      allow read, write: if isUser() && request.auth.uid == uid;
    }

    // /characters/{id}
    // Any signed-in user can view character sheets. You write your own; the DM of
    // the campaign a hunter is currently in can manage it (confirm death/recover).
    match /characters/{id} {
      // Transformation is DM-owned: gains are rolled physically at the table and
      // recorded by the DM. The owner may only ever REDUCE transformationLevel
      // (rests) and only CLEAR activeTransformations — never raise or add.
      function ownerTransformationOk() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return (!changed.hasAny(['transformationLevel'])
            || request.resource.data.get('transformationLevel', 0) <= resource.data.get('transformationLevel', 0))
          && (!changed.hasAny(['activeTransformations'])
            || request.resource.data.get('activeTransformations', []).size() == 0);
      }

      allow read: if isUser();
      // You create your own; a campaign's DM may also author a hunter bound to
      // their campaign, but only for an existing MEMBER of it (a real player or
      // a seeded bot) — never an arbitrary uid.
      allow create: if isUser() && (
        request.resource.data.ownerUid == request.auth.uid
        || (request.resource.data.campaignId != null
            && isCampaignDM(request.resource.data.campaignId)
            && exists(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)/members/$(request.resource.data.ownerUid)))
      );
      allow update: if isUser() && (
        (resource.data.ownerUid == request.auth.uid && ownerTransformationOk())
        || (resource.data.campaignId != null && isCampaignDM(resource.data.campaignId))
      );
      allow delete: if isUser() && (
        resource.data.ownerUid == request.auth.uid
        || (resource.data.campaignId != null && isCampaignDM(resource.data.campaignId))
      );
    }

    // /archive/{id} — transient dead/deleted hunters (purged when a game ends).
    match /archive/{id} {
      allow read, delete: if isUser();
      allow create: if isUser() && (
        request.resource.data.card.ownerUid == request.auth.uid
        || (request.resource.data.card.campaignId != null
            && isCampaignDM(request.resource.data.card.campaignId))
      );
    }

    // /campaigns/{id} — a campaign/server and its membership.
    match /campaigns/{id} {
      allow read: if isUser();
      allow create: if isUser() && request.resource.data.dmUid == request.auth.uid;
      allow update: if isUser(); // joining adds yourself to memberUids
      allow delete: if isCampaignDM(id);

      match /members/{uid} {
        allow read: if isUser();
        allow write: if isUser() && (request.auth.uid == uid || isCampaignDM(id));
      }
    }

    // /activity/{id} — the campaign chronicle. Append-only: members write
    // events about themselves (actorUid must match); nobody edits history.
    // Reads: members see a campaign's log; a hunter's OWNER sees that hunter's
    // history across campaigns (queries must filter ownerUid == their uid so
    // the rule is provable). The DM purges the log with the campaign.
    match /activity/{id} {
      allow read: if isMember(resource.data.campaignId)
        || (isUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isMember(request.resource.data.campaignId)
        && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isCampaignDM(resource.data.campaignId);
    }

    // /sessions/{id} — campaign schedule. Members read; the DM manages dates.
    match /sessions/{id} {
      allow read: if isMember(resource.data.campaignId);
      allow create: if isCampaignDM(request.resource.data.campaignId);
      allow update, delete: if isCampaignDM(resource.data.campaignId);

      match /rsvps/{uid} {
        allow read: if isMember(sessionCampaignId(id));
        allow write: if request.auth.uid == uid && isMember(sessionCampaignId(id));
      }
    }

    // /games/{gameId} — live play, owned by its DM. Standalone sessions use
    // participantUids for invitations; legacy campaign games remain valid.
    match /games/{gameId} {
      allow read: if canReadGameData(resource.data);
      allow create: if isUser()
        && request.resource.data.dmUid == request.auth.uid
        && request.resource.data.participantUids is list
        && (request.resource.data.campaignId == null
          || isCampaignDM(request.resource.data.campaignId));
      allow update: if isUser()
        && resource.data.dmUid == request.auth.uid
        && request.resource.data.dmUid == resource.data.dmUid;
      allow delete: if isUser() && resource.data.dmUid == request.auth.uid;

      match /participants/{uid} {
        allow read: if canReadGame(gameId);
        allow write: if isGameDM(gameId)
          || (gameCampaignId(gameId) != null
            && isMember(gameCampaignId(gameId))
            && request.auth.uid == uid);
      }

      match /loot/{lootId} {
        allow read: if canReadGame(gameId);
        allow create, update: if isGameDM(gameId)
          || (gameCampaignId(gameId) != null && isMember(gameCampaignId(gameId)));
        allow delete: if isGameDM(gameId)
          || (gameCampaignId(gameId) != null && isCampaignDM(gameCampaignId(gameId)));
      }

      // Combat tracker: members read the initiative tracker; the DM edits it.
      // Members may also finish off / clear MONSTERS (their Slain + Remove
      // buttons) — but only the HP field, and never a PC row: no healing,
      // initiative shuffling or note rewrites from the player side.
      match /combatants/{cid} {
        allow read: if canReadGame(gameId);
        allow write: if isGameDM(gameId)
          || (gameCampaignId(gameId) != null && isCampaignDM(gameCampaignId(gameId)));
        allow update: if gameCampaignId(gameId) != null
          && isMember(gameCampaignId(gameId))
          && resource.data.kind == "monster"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["currentHp"]);
        allow delete: if gameCampaignId(gameId) != null
          && isMember(gameCampaignId(gameId))
          && resource.data.kind == "monster";
      }
    }

    // /trades/{tradeId} — player↔player, settled by the settleTrade Cloud
    // Function (Admin SDK, bypasses these rules). Members read (DM log); the
    // offerer creates; either party may accept/decline/cancel.
    match /trades/{tradeId} {
      allow read: if isMember(resource.data.campaignId);
      allow create: if isMember(request.resource.data.campaignId)
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if isMember(resource.data.campaignId)
        && request.auth.uid in [resource.data.fromUid, resource.data.toUid]
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status in ["accepted", "declined", "cancelled"];
      allow delete: if isCampaignDM(resource.data.campaignId);
    }

    // /shopListings/{id} — the DM's per-campaign storefront. Members browse; the
    // DM stocks/prices/pulls items. Buying mutates the buyer's own /characters
    // doc (covered by the owner-write rule above).
    match /shopListings/{id} {
      allow read: if isMember(resource.data.campaignId);
      allow create: if isCampaignDM(request.resource.data.campaignId)
        && request.resource.data.priceGp is number
        && request.resource.data.priceGp >= 0;
      allow update, delete: if isCampaignDM(resource.data.campaignId);
    }

    // /sellRequests/{id} — a player asks to sell an item; the DM prices then
    // approves (crediting the seller's own character) or declines. A request is
    // raised unpriced ("requested"); only the DM may price/approve/decline, and
    // the seller may cancel (declined).
    match /sellRequests/{id} {
      allow read: if isMember(resource.data.campaignId);
      allow create: if isMember(request.resource.data.campaignId)
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.priceGp == null
        && request.resource.data.status == "requested"
        && request.resource.data.qty is int
        && request.resource.data.qty > 0;
      allow update: if isCampaignDM(resource.data.campaignId)
        || (request.auth.uid == resource.data.sellerUid
            && request.resource.data.status == "declined"
            && request.resource.data.priceGp == resource.data.priceGp
            && request.resource.data.itemId == resource.data.itemId
            && request.resource.data.qty == resource.data.qty
            && request.resource.data.characterId == resource.data.characterId);
      allow delete: if isCampaignDM(resource.data.campaignId);
    }

    // Lock everything else down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
