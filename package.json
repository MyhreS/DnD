{
  "name": "catacombs-and-starspawns",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Companion app for our Catacombs & Starspawns tabletop campaign.",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run codex:generate && doppler run -- vite",
    "build": "bun run codex:generate && tsc -b && doppler run -- vite build",
    "build:ci": "bun run codex:generate && tsc -b && vite build",
    "build:workshop": "node scripts/with-firebase-web-config.mjs bun run build:workshop:ci",
    "build:workshop:ci": "tsc -b && vite build --config vite.workshop.config.ts",
    "build:firebase": "node scripts/build-with-firebase-config.mjs",
    "preview": "doppler run -- vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deadcode": "knip",
    "deadcode:fix": "knip --fix --allow-remove-files",
    "check": "bun run test:codex && bun run test:game-presentation && bun run test:enemy-library && bun run test:workshop-manager && bun run test:pwa-update-policy && tsc -b && eslint . && knip",
    "token": "doppler run -- bun scripts/mint-test-token.mjs",
    "e2e": "node scripts/e2e-character-automation.mjs && node scripts/e2e-game-page.mjs && node scripts/e2e-confirmations.mjs && node scripts/e2e-codex.mjs && node scripts/e2e-app-audit.mjs && bun run e2e:workshop && npm run e2e:battle",
    "e2e:audit": "node scripts/e2e-app-audit.mjs",
    "e2e:codex": "node scripts/e2e-codex.mjs",
    "e2e:character-automation": "node scripts/e2e-character-automation.mjs",
    "e2e:game": "node scripts/e2e-game-page.mjs",
    "e2e:confirmations": "node scripts/e2e-confirmations.mjs",
    "e2e:upgrade": "node scripts/e2e-upgrade-required-choices.mjs",
    "e2e:battle": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions \"node scripts/e2e-battle-screen.mjs\"",
    "e2e:workshop": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions,storage \"node scripts/with-firebase-web-config.mjs node scripts/e2e-workshop.mjs\"",
    "test:game-card": "bun scripts/game-card-data-test.ts",
    "test:game-presentation": "bun scripts/game-presentation-test.ts",
    "test:enemy-library": "bun scripts/enemy-library-test.ts",
    "test:workshop-manager": "bun scripts/workshop-manager-test.ts",
    "test:workshop-manager-restart": "firebase emulators:exec --only firestore \"bun scripts/workshop-manager-restart-test.mjs\"",
    "test:pwa-update-policy": "bun scripts/pwa-update-policy-test.ts",
    "test:character-automation": "bun scripts/character-automation-test.ts",
    "test:game-sessions": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions \"USE_FIREBASE_EMULATORS=1 bun scripts/smoke-rules.mjs\"",
    "migrate:character-sheets": "bun scripts/migrate-character-sheets.ts",
    "migrate:battle-view": "doppler run -- bun scripts/migrate-battle-view.ts",
    "migrate:enemy-library": "doppler run -- bun scripts/migrate-enemy-library.ts",
    "codex:generate": "node scripts/generate-codex-data.mjs && node scripts/generate-feats-data.mjs",
    "test:codex": "bun scripts/codex-data-test.ts",
    "smoke": "doppler run -- bun scripts/smoke-rules.mjs",
    "icons": "bun run scripts/generate-icons.mjs",
    "art:classes": "node scripts/build-class-art.mjs",
    "deploy": "bun run build:firebase && firebase deploy --only hosting:app,firestore:rules,storage,functions",
    "deploy:hosting": "bun run build:firebase && firebase deploy --only hosting:app",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "qa": "doppler run -- node scripts/qa-crawl.mjs",
    "workshop:bot": "bun scripts/workshop-manager.ts",
    "workshop:bot:once": "bun scripts/workshop-manager.ts --once",
    "workshop:storage-cors": "gcloud storage buckets update gs://dandd-ea955.firebasestorage.app --cors-file=storage.cors.json --project=dandd-ea955 --account=simonmyhre1@gmail.com",
    "deploy:workshop": "bun run build:workshop && firebase deploy --only hosting:workshop"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "firebase": "^11.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^19.0.0-beta-3229e95-20250315",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.18",
    "firebase-admin": "^13.0.0",
    "globals": "^15.14.0",
    "knip": "^5.42.0",
    "playwright": "^1.61.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1"
  },
  "trustedDependencies": [
    "@firebase/util",
    "protobufjs"
  ],
  "overrides": {
    "protobufjs": "7.6.5"
  }
}
